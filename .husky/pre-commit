#!/bin/sh

STAGED=$(git diff --cached --name-only --diff-filter=d)
if [ -n "$STAGED" ]; then
  echo "$STAGED" | xargs npx prettier --write --ignore-unknown || exit 1
fi
git add -u

script_dir=$(dirname "$0")/..
. "$script_dir/scripts/parallel-exit-on-failure.sh"

echo "  Running checks..."

# Fork: the test suites run on GitHub (.github/workflows/ci.yml), the hook keeps the fast checks
parallel_exit_on_failure \
  "lint"      "npm run lint" \
  "typecheck" "npm run typecheck" \
  "client"    "cd client && npx tsc --noEmit" \
  "format"    "npm run format" \
  "duplicate" "npm run duplicate"
